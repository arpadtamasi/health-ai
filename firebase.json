{
  "hosting": {
    "public": "site/dist",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "/_expo/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      },
      {
        "source": "/mcp",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      },
      {
        "source": "/mcp/**",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      },
      {
        "source": "/oauth/**",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      },
      {
        "source": "/.well-known/**",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      },
      {
        "source": "/authorize",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      },
      {
        "source": "/token",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      },
      {
        "source": "/register",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      },
      {
        "source": "/revoke",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      },
      {
        "source": "/reconnect",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      },
      {
        "source": "/health",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
