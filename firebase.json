{
  "hosting": {
    "public": "site/dist",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      },
      {
        "source": "**",
        "run": {
          "serviceId": "health-ai",
          "region": "europe-west1"
        }
      }
    ]
  }
}
