  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The filled action: Sign in, Save, consent. Full pill, 48px.",
      "html": "<button class=\"ds-btn-primary\">Mentés</button>",
      "css": ".ds-btn-primary{background:#1d5c4d;color:#ffffff;font-family:Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif;font-weight:600;font-size:16px;min-height:48px;padding:0 20px;border:none;border-radius:999px;cursor:pointer;transition:filter .15s} .ds-btn-primary:hover{filter:brightness(1.06)} .ds-btn-primary:focus-visible{outline:3px solid #1d5c4d;outline-offset:3px} .ds-btn-primary:active{filter:brightness(.94)} .ds-btn-primary:disabled{opacity:.5}"
    },
    {
      "name": "What-now Button",
      "kind": "button",
      "refersTo": "button-what-now",
      "description": "The home's one outlined action, Mit egyek most?, with a Lucide utensils icon.",
      "html": "<button class=\"ds-btn-whatnow\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2\"/><path d=\"M7 2v20\"/><path d=\"M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7\"/></svg>Mit egyek most?</button>",
      "css": ".ds-btn-whatnow{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:48px;border-radius:24px;border:1.5px solid #1d5c4d;background:#fbfcfa;color:#1d5c4d;font-family:Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif;font-weight:700;font-size:15.5px;cursor:pointer;transition:background .15s} .ds-btn-whatnow:hover{background:#f1f4ef} .ds-btn-whatnow:focus-visible{outline:3px solid #1d5c4d;outline-offset:3px}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "A 44px pill for usual items, meal types and card actions; selected uses Pale Leaf, danger uses Error Red text.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\">Cappuccino</button><button class=\"ds-chip ds-chip-on\">Ebéd</button><button class=\"ds-chip ds-chip-danger\">Törlés</button></div>",
      "css": ".ds-chips{display:flex;gap:6px;flex-wrap:wrap} .ds-chip{min-height:44px;padding:0 16px;border-radius:999px;border:1px solid #d2dacf;background:#fbfcfa;color:#17201b;font-family:Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif;font-size:14px;cursor:pointer;transition:background .15s} .ds-chip:hover{background:#f1f4ef} .ds-chip:focus-visible{outline:3px solid #1d5c4d;outline-offset:2px} .ds-chip-on{background:#d8e9e0;border-color:#d8e9e0;color:#0e3a30;font-weight:600} .ds-chip-danger{color:#b3261e}"
    },
    {
      "name": "Composer",
      "kind": "input",
      "refersTo": "composer-field",
      "description": "The dock: green camera circle, Ceramic Low pill field, green Send circle when there is something to send.",
      "html": "<div class=\"ds-dock\"><button class=\"ds-round\" aria-label=\"Kamera\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z\"/><circle cx=\"12\" cy=\"13\" r=\"3\"/></svg></button><input class=\"ds-field\" placeholder=\"Írj vagy mondd...\"><button class=\"ds-round\" aria-label=\"Küldés\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12 7-7 7 7\"/><path d=\"M12 19V5\"/></svg></button></div>",
      "css": ".ds-dock{display:flex;align-items:center;gap:8px;padding:10px 14px 14px;background:#fbfcfa;border-top:1px solid #d2dacf} .ds-round{width:44px;height:44px;flex:none;border-radius:22px;border:none;background:#1d5c4d;color:#ffffff;display:grid;place-items:center;cursor:pointer} .ds-round:focus-visible{outline:3px solid #1d5c4d;outline-offset:2px} .ds-field{flex:1;min-height:44px;padding:11px 16px;border-radius:22px;border:1px solid #d2dacf;background:#f1f4ef;color:#17201b;font-family:Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif;font-size:16px} .ds-field::placeholder{color:#59675f} .ds-field:focus-visible{outline:2px solid #17201b;outline-offset:0}"
    },
    {
      "name": "Line and Mark",
      "kind": "custom",
      "refersTo": "line",
      "description": "The sentence under the plate with its drawn mark: arrow down (behind), up (ahead), dot (on plan), tick (done).",
      "html": "<div class=\"ds-line\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"9\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M11 6.5v8M7.5 11.5 11 15l3.5-3.5\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg><div><p class=\"ds-line-t\">180 kcal-lal a terv alatt.</p><p class=\"ds-line-s\">Fehérjéből 125 g hiányzik még.</p></div></div>",
      "css": ".ds-line{display:flex;gap:8px;color:#b04314;padding:0 20px} .ds-line svg{flex:none;margin-top:1px} .ds-line p{margin:0} .ds-line-t{font-family:Gabarito, \"Trebuchet MS\", system-ui, sans-serif;font-weight:600;font-size:19px;line-height:24px;letter-spacing:-.2px;color:#17201b;font-variant-numeric:tabular-nums} .ds-line-s{font-family:Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif;font-size:14px;color:#59675f;margin-top:2px}"
    },
    {
      "name": "Figures Row",
      "kind": "custom",
      "refersTo": "figure",
      "description": "Four equal cells, identity dot and name over eaten / goal; the chosen one is ink-outlined.",
      "html": "<div class=\"ds-figs\"><button class=\"ds-fig ds-fig-on\"><span class=\"ds-fig-n\"><i style=\"background:#e07a4f\"></i>Fehérje</span><b>35 / 160 g</b></button><button class=\"ds-fig\"><span class=\"ds-fig-n\"><i style=\"background:#f1e8d3\"></i>Szénh.</span><b>80 / 185 g</b></button><button class=\"ds-fig\"><span class=\"ds-fig-n\"><i style=\"background:#7f9e47\"></i>Zsír</span><b>27 / 80 g</b></button><button class=\"ds-fig\"><span class=\"ds-fig-n\"><i style=\"background:#3a87d0\"></i>Víz</span><b>0,5 / 2,5 l</b></button></div>",
      "css": ".ds-figs{display:flex;gap:4px;padding:0 12px;background:#e4eae1} .ds-fig{flex:1;min-width:0;min-height:44px;padding:5px 6px;border-radius:14px;border:1.5px solid transparent;background:transparent;text-align:left;cursor:pointer} .ds-fig:focus-visible{outline:3px solid #1d5c4d;outline-offset:1px} .ds-fig-on{border-color:#17201b;background:#fbfcfa} .ds-fig-n{display:flex;align-items:center;gap:5px;font-family:Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif;font-weight:600;font-size:12.5px;color:#17201b} .ds-fig-n i{width:9px;height:9px;border-radius:5px;display:block} .ds-fig b{display:block;font-family:Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif;font-weight:700;font-size:13px;color:#17201b;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Day Entry",
      "kind": "chip",
      "refersTo": "day-entry",
      "description": "An entry in the Ma eddig strip: main-macro dot, time, short name, amount. Highlighted ink, failed red, saving dimmed.",
      "html": "<div class=\"ds-strip\"><button class=\"ds-entry\"><i style=\"background:#7f9e47\"></i><span class=\"ds-t\">10:30</span><span>Cappuccino</span><b>90</b></button><button class=\"ds-entry ds-entry-on\"><i style=\"background:#3a87d0\"></i><span class=\"ds-t\">11:15</span><span>Víz</span><b>250 ml</b></button><button class=\"ds-entry ds-entry-failed\"><i style=\"background:#e07a4f\"></i><span class=\"ds-t\">12:40</span><span>Túró</span><b>180</b></button></div>",
      "css": ".ds-strip{display:flex;gap:6px;padding:8px 16px;background:#e4eae1;overflow-x:auto} .ds-entry{display:flex;align-items:center;gap:7px;min-height:40px;padding:0 10px;border-radius:12px;border:1.5px solid #d2dacf;background:#fbfcfa;font-family:Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif;font-size:13px;color:#17201b;white-space:nowrap;cursor:pointer} .ds-entry:focus-visible{outline:3px solid #1d5c4d;outline-offset:1px} .ds-entry i{width:9px;height:9px;border-radius:5px;display:block} .ds-entry .ds-t{color:#59675f;font-variant-numeric:tabular-nums} .ds-entry b{font-weight:700;font-variant-numeric:tabular-nums} .ds-entry-on{border-color:#17201b} .ds-entry-failed{border-color:#b3261e}"
    },
    {
      "name": "Action Bar",
      "kind": "custom",
      "refersTo": "action-bar",
      "description": "Inverse ink bar above the dock with underlined actions; Error Red ground when a save failed.",
      "html": "<div class=\"ds-bar\"><span>Naplózva: Chicken with rice · 560 kcal</span><button>Átírás</button><button>Visszavonás</button></div>",
      "css": ".ds-bar{display:flex;align-items:center;gap:6px;min-height:48px;margin:0 14px;padding:0 6px 0 14px;border-radius:16px;background:#17201b;color:#e4eae1;font-family:Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif;font-weight:500;font-size:14px} .ds-bar span{flex:1} .ds-bar button{min-height:44px;padding:0 8px;border:none;background:none;color:inherit;font:inherit;font-weight:700;text-decoration:underline;cursor:pointer} .ds-bar button:focus-visible{outline:2px solid #e4eae1;outline-offset:-2px;border-radius:8px}"
    },
    {
      "name": "Suggestion",
      "kind": "card",
      "refersTo": "suggestion",
      "description": "An option on the what-now sheet; first tap picks (ink outline, green hint), second tap logs.",
      "html": "<div class=\"ds-sheet\"><h3>Mit egyek most?</h3><button class=\"ds-sug ds-sug-on\"><span class=\"ds-sug-h\"><b>Chicken with rice</b><b>560 kcal</b></span><span class=\"ds-sug-r\">Closes most of the protein gap.</span><span class=\"ds-sug-k\">Koppints rá még egyszer, és naplózom.</span></button><button class=\"ds-sug\"><span class=\"ds-sug-h\"><b>Egg salad</b><b>310 kcal</b></span></button></div>",
      "css": ".ds-sheet{display:flex;flex-direction:column;gap:8px;padding:8px 16px 14px;background:#fbfcfa;border:1px solid #d2dacf;border-bottom:0;border-radius:26px 26px 0 0} .ds-sheet h3{margin:8px 0 4px;font-family:Gabarito, \"Trebuchet MS\", system-ui, sans-serif;font-weight:800;font-size:20px;color:#17201b} .ds-sug{display:flex;flex-direction:column;gap:1px;text-align:left;padding:9px 12px;border-radius:14px;border:1.5px solid #d2dacf;background:#fbfcfa;font-family:Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif;cursor:pointer} .ds-sug:hover{background:#f1f4ef} .ds-sug:focus-visible{outline:3px solid #1d5c4d;outline-offset:1px} .ds-sug-on{border-color:#17201b;background:#f1f4ef} .ds-sug-h{display:flex;justify-content:space-between;gap:8px;font-size:15px;color:#17201b;font-variant-numeric:tabular-nums} .ds-sug-r{font-size:13px;color:#59675f} .ds-sug-k{font-size:13px;font-weight:600;color:#1d5c4d;margin-top:2px}"
    },
    {
      "name": "Chat Bubbles",
